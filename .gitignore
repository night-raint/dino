# Unity standard ignore file
# [Ll]ibrary/ is Unity's local cache
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# UserSettings: explicitly preserved per course assignment specification
# /[Uu]ser[Ss]ettings/

# Asset meta data should only be ignored when on Plastic SCM
!/[Aa]ssets/**/*.meta

# Autogenerated VS/VSCode/Rider solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D Generated File On Crash Reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db

# IDE cache
.vs/
.gradle/
.idea/
.vscode/

# Visual Studio config
.vsconfig
